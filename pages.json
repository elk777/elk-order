{
	"easycom": {
		"autoscan": true,
		// 注意一定要放在custom里，否则无效，https://ask.dcloud.net.cn/question/131175
		"custom": {
			"^u--(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^leo-drag": "@/uni_modules/leo-drag/components/leo-drag.vue",
			"^uni-calendar": "@/uni_modules/uni-calendar/components/uni-calendar.vue"
		}
	},
	"pages": [
		// #ifdef H5
		// 管理端仅在 H5 产物中存在：条件编译保证小程序包内不含 pages-admin 任何代码。
		// 刻意排在数组首位——H5 产物专供 admin.lucky-elk.xyz，启动页即后台登录页，
		// 无需再靠 nginx rewrite 把根路径指向管理端路由。
		{
			"path": "pages-admin/login/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "运营后台"
			}
		},
		{
			"path": "pages-admin/feedback/list",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "反馈工单",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages-admin/feedback/detail",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "工单详情"
			}
		},
		// #endif
		//pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/home/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationBarBackgroundColor": "#FFF0F2",
				"navigationBarTextStyle": "black",
				"backgroundColor": "#FFF9F7"
			}
		},
		{
			"path": "pages/sort/index",
			"style": {
				"navigationStyle": "custom",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/recipe/redact",
			"style": {}
		},
		{
			"path": "pages/recipe/ai-generate",
			"style": {
				"navigationBarTitleText": "灵感成菜",
				"navigationBarBackgroundColor": "#FFF0F6",
				"navigationBarTextStyle": "black",
				"backgroundColor": "#FFF7FA"
			}
		},
		{
			"path": "pages/recipe/details",
			"style": {
				"navigationBarTitleText": "菜谱详情"
			}
		},
		{
			"path": "pages/recipe/classify",
			"style": {
				"navigationBarTitleText": "分类管理"
			}
		},
		{
			"path": "pages/order/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/my/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/my/integral",
			"style": {
				"navigationBarTitleText": "我的积分"
			}
		},
		{
			"path": "pages/my/attendance",
			"style": {
				"navigationBarTitleText": "每日签到",
				"navigationBarBackgroundColor": "#FFF0F6",
				"navigationBarTextStyle": "black",
				"backgroundColor": "#FFF7FA"
			}
		},
		{
			"path": "pages/my/calendar",
			"style": {
				"navigationBarTitleText": "烹饪日历",
				"navigationBarBackgroundColor": "#FFF0F6",
				"navigationBarTextStyle": "black",
				"backgroundColor": "#FFF7FA"
			}
		},
		{
			"path": "pages/my/feedback/index",
			"style": {
				"navigationBarTitleText": "意见反馈",
				"navigationBarBackgroundColor": "#FFF0F6",
				"navigationBarTextStyle": "black",
				"backgroundColor": "#FFF7FA"
			}
		},
		{
			"path": "pages/my/feedback/list",
			"style": {
				"navigationBarTitleText": "我的反馈",
				"navigationBarBackgroundColor": "#FFF0F6",
				"navigationBarTextStyle": "black",
				"backgroundColor": "#FFF7FA"
			}
		},
		{
			"path": "pages/my/feedback/detail",
			"style": {
				"navigationBarTitleText": "反馈详情",
				"navigationBarBackgroundColor": "#FFF0F6",
				"navigationBarTextStyle": "black",
				"backgroundColor": "#FFF7FA"
			}
		},
		{
			"path": "pages/cart/AffirmOrder",
			"style": {
				"navigationBarTitleText": "确认订单"
			}
		},
		{
			"path": "pages/order/details",
			"style": {
				"navigationBarTitleText": "订单详情"
			}
		}
	],
	"tabBar": {
		"custom": true,
		"list": [
			{
				"pagePath": "pages/home/index"
			},
			{
				"pagePath": "pages/sort/index"
			},
			{
				"pagePath": "pages/order/index"
			},
			{
				"pagePath": "pages/my/index"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "偏爱厨房",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}
